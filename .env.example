# R2 Increment 1: deferred citizen/forms/payments/notifications are unconditionally closed.
# No payment, signup or notification flag can reopen them. No Neon migration is installed.
# Retained R1 Supabase settings below remain required; do not supply retired delivery keys.
# See docs/r2/DEFERRED_WORKFLOW_SHUTDOWN.md for hosted shutdown/release blockers.
# ─── TAL.GOV ROOT — ENVIRONMENT VARIABLES REFERENCE ─────────────────────────
# The project is now split into frontend/ and backend/ sub-projects.
# Each has its own .env.example with the variables it actually needs.
#
#   frontend/.env.example  — VITE_* public variables (safe for browser)
#   backend/.env.example   — Server secrets (NEVER expose to browser)
#
# This root file is kept only for legacy compatibility and CI reference.
# R2 discovery does not change the runtime variables below. See docs/r2/ARCHITECTURE.md.
# Neon settings remain proposed until adapters and provider capabilities are verified.
# Copy the relevant sub-project .env.example to its .env instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── FRONTEND (copy to frontend/.env) ─────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_ENABLE_MOCK_DATA=false

# ── BACKEND (copy to backend/.env) ───────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Backend only — NEVER prefix with VITE_
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ALLOWED_ORIGINS=http://localhost:5173
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@talibon.gov.ph
EMAIL_FROM_NAME=Municipality of Talibon
XENDIT_SECRET_KEY=your_xendit_secret_key
ENABLE_MOCK_DATA=false
