# Final R2 application configuration. Server only; never prefix secrets with VITE_.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
ENABLE_MOCK_DATA=false
# Pooled least-privilege Neon URL with verified TLS and channel binding.
# A LOGIN member of talgov_runtime only; never neondb_owner or a migrator.
DATABASE_URL=
# Staff identity, sessions and MFA use pinned Better Auth on Neon PostgreSQL.
STAFF_AUTH_DATABASE_URL=
STAFF_AUTH_ORIGIN=http://localhost:5173
STAFF_AUTH_SECRET=
STAFF_MAIL_API_KEY=
STAFF_MAIL_FROM=
# Media metadata and private Neon S3-compatible storage.
MEDIA_DATABASE_URL=
MEDIA_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Offline rehearsal tools only. No automatic startup or production migrations.
R2_MIGRATION_DATABASE_URL=
R2_SOURCE_DATABASE_URL=

# VERCEL=1 is supplied by Vercel, never set on a publicly reachable non-Vercel host.
# Vercel client identity uses its overwritten X-Forwarded-For header; other hosts
# use req.ip with explicitly trusted proxy addresses. Never set TRUSTED_PROXIES=*.
# All three runtime URLs must target the same fresh schema set with talgov_runtime
# privileges. Auth policy tables also hold shared HTTP throttles and audit events.
# Production requires every staff/mail/storage setting above, HTTPS origins and
# a signing secret of at least 43 characters. URLs never belong in browser config.
# R2_SOURCE_DATABASE_URL is archival tooling only; do not use it for production setup.

# Guarded staging runner only: direct restricted migrator URL; never runtime identity.
R2_STAGING_DATABASE_URL=
NEON_API_KEY=
