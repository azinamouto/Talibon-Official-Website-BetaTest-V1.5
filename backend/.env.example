# R2 Increment 1: deferred citizen/forms/payments/notifications are unconditionally closed.
# No payment, signup or notification flag can reopen them. No Neon migration is installed.
# Retained R1 Supabase settings below remain required; do not supply retired delivery keys.
# See docs/r2/DEFERRED_WORKFLOW_SHUTDOWN.md for hosted shutdown/release blockers.
# ─── BACKEND ENVIRONMENT VARIABLES ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# NEVER prefix backend secrets with VITE_ — that would expose them to the browser.

# R2 discovery only: this file still configures R1. No Neon adapter is installed.
# Proposed server-only names: DATABASE_URL (pooled), DATABASE_DIRECT_URL (migrations).
# Auth/storage configuration names stay unbound until provider capability tests pass.
# See docs/r2/AUTH_AND_STORAGE_CONTRACTS.md and docs/r2/NEON_MIGRATION_PLAN.md.
# Never use VITE_ for database, auth-management, storage or migration secrets.

NODE_ENV=development
PORT=3000

# Application URL (used for tracking link generation in email notifications)
APP_URL=http://localhost:3000

# Supabase — server-side only (service role key — NEVER expose to browser)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Legacy projects may use SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY.

# Allowed CORS origins (comma-separated)
# Development: http://localhost:5173
# Production: https://talibon.gov.ph,https://www.talibon.gov.ph
ALLOWED_ORIGINS=http://localhost:5173
# Explicit proxy IPs/CIDRs only. Empty means forwarded headers are untrusted.
TRUSTED_PROXIES=

# Email (Resend — optional, falls back to console logger if not set)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@talibon.gov.ph
EMAIL_FROM_NAME=Municipality of Talibon

# Historical payment settings: unused by R2; do not provision checkout credentials.
XENDIT_SECRET_KEY=your_xendit_secret_key
# Frontend origin for payment redirects. HTTPS in production; no path or credentials.
# R2 checkout always returns 410, including when this value is configured.
PAYMENT_RETURN_ORIGIN=http://localhost:5173

# Mock data (development only)
ENABLE_MOCK_DATA=false
