{
  "name": "talgov-backend",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && node -e \"import fs from 'node:fs'; fs.writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}));\" && esbuild src/serverless.ts --bundle --platform=node --target=node20 --format=esm --outfile=../api/index.js --packages=external",
    "build:tsc": "tsc -p tsconfig.json",
    "build:serverless": "esbuild src/serverless.ts --bundle --platform=node --target=node20 --format=esm --outfile=../api/index.js --packages=external",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "lint": "tsc --noEmit",
    "clean": "npx rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@supabase/supabase-js": "^2.101.1",
    "axios": "^1.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.0.2",
    "xendit-node": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.1"
  }
}
