{
  "name": "talgov-backend",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "db:r2:migrate": "npm run build:tsc && node scripts/r2-migrate.cjs",
    "db:r2:transfer": "node scripts/r2-transfer.cjs",
    "test:r2:db": "npm run build:tsc && powershell -NoProfile -ExecutionPolicy Bypass -File test/run-r2-database-tests.ps1",
    "notifications:work": "node dist/api/notifications/email-worker.js",
    "dev": "npm run build:tsc && node dist/main.js",
    "build": "npm run build:tsc",
    "build:tsc": "tsc -p tsconfig.json && node --input-type=commonjs -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:serverless": "npm run build:tsc",
    "start": "node dist/main.js",
    "start:dev": "npm run dev",
    "lint": "eslint src && tsc --noEmit",
    "clean": "npx rimraf dist",
    "test": "npm run build:tsc && jest --runInBand && node --test --test-timeout=120000 test/*.test.cjs",
    "test:load": "npm run build:tsc && node --test test/load/metrics.test.cjs && node test/load/run.cjs",
    "test:db": "powershell -NoProfile -ExecutionPolicy Bypass -File test/run-database-tests.ps1",
    "test:unit": "npm run build:tsc && jest --runInBand",
    "contracts:export": "npm run build:tsc && node scripts/export-openapi.cjs",
    "contracts:check": "npm run build:tsc && node scripts/export-openapi.cjs --check"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "11.4.7",
    "@supabase/supabase-js": "^2.101.1",
    "axios": "^1.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.0.2",
    "xendit-node": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.24.2",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.70.0",
    "vite": "^6.1.1"
  }
}
