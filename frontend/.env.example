# ─── FRONTEND ENVIRONMENT VARIABLES ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All VITE_* values are exposed to the browser. Never put secrets in them.

# Backend API URL — points to the NestJS server
# Development: http://localhost:3000
# Production: https://api.talibon.gov.ph (or your Railway/Cloud Run URL)
VITE_API_URL=http://localhost:3000

# Supabase (public anon key — safe to expose)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# Feature flags
VITE_ENABLE_MOCK_DATA=false
