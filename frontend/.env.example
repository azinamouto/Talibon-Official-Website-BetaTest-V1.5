# ─── FRONTEND ENVIRONMENT VARIABLES ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Only VITE_* variables are safe for browser exposure.

# Backend API URL — points to the NestJS server
# Development: http://localhost:3000
# Production: https://api.talibon.gov.ph (or your Railway/Cloud Run URL)
VITE_API_URL=http://localhost:3000

# Supabase (public anon key — safe to expose)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI (currently injected via vite.config.ts define — review before production)
GEMINI_API_KEY=your_gemini_api_key_here

# Feature flags
VITE_ENABLE_MOCK_DATA=false
