# R2 Increment 1: deferred citizen/forms/payments/notifications are unconditionally closed.
# No payment, signup or notification flag can reopen them. No Neon migration is installed.
# Retained R1 Supabase settings below remain required; do not supply retired delivery keys.
# See docs/r2/DEFERRED_WORKFLOW_SHUTDOWN.md for hosted shutdown/release blockers.
# ─── FRONTEND ENVIRONMENT VARIABLES ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All VITE_* values are exposed to the browser. Never put secrets in them.

# Backend API URL — points to the NestJS server
# Development: http://localhost:3000
# Production: https://api.talibon.gov.ph (or your Railway/Cloud Run URL)
# R2 discovery: existing R1 variables remain required until consumers are migrated.
# Target public data access is through NestJS; no database/storage secrets in VITE_*.
# Neon auth browser configuration is pending a verified session integration.
# See docs/r2/AUTH_AND_STORAGE_CONTRACTS.md before changing providers.
VITE_API_URL=http://localhost:3000

# Supabase public browser configuration (same project as the backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may set this instead of VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=


# Feature flags
VITE_ENABLE_MOCK_DATA=false
# Historical flag is ignored in R2. It cannot enable checkout or payment-return confirmation.
VITE_SUBMISSION_PAYMENTS_ENABLED=false
## Development-only mock admin layout at /admin-preview; never grants live access.
VITE_DASHBOARD_PREVIEW=false
