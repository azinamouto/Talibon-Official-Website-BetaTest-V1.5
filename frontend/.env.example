# All VITE_ values are public. API requests use /api through the development proxy.
VITE_API_URL=http://localhost:3000

VITE_ENABLE_MOCK_DATA=false
# Public build flag; match the server flag. Email password recovery is deferred.
VITE_STAFF_PASSWORD_RECOVERY_ENABLED=false
# Development-only layout preview; never grants staff access.
VITE_DASHBOARD_PREVIEW=false
