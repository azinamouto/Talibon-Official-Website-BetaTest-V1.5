{
  "name": "talgov-frontend",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "npx rimraf dist",
    "test": "node --test test/*.test.cjs",
    "test:react": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "test:eservices": "playwright test --config playwright.eservices.config.ts",
    "test:contracts:browser": "playwright test --config playwright.contract.config.ts",
    "mock:api": "node mocks/server.mjs",
    "dev:mock": "node mocks/dev.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.50.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.15.0",
    "dotenv": "^16.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.2.0",
    "react-router-hash-link": "^2.4.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.4",
    "@types/react-router-hash-link": "^2.4.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.7",
    "typescript": "~5.7.3",
    "vite": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
