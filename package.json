{
  "name": "react-example",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "ops:smoke": "node ops/smoke.mjs",
    "ops:monitor": "node ops/monitor.mjs",
    "test:ops": "node --test ops/test/*.test.mjs",
    "start:backend": "npm run start --prefix backend",
    "preview:frontend": "npm run preview --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "clean": "npx rimraf dist backend/dist frontend/dist"
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=22.16.0 <23"
  }
}
